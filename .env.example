# Copy this file to .env and replace all placeholder values.
POSTGRES_DB=bugtracker
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_a_strong_database_password
WEB_PORT=5173
CLIENT_URL=http://localhost:5173
# Browser requests use the same frontend origin; Nginx proxies /api/ to the API container.
VITE_API_URL=/api/v1
JWT_ACCESS_SECRET=replace_with_a_random_secret_at_least_32_characters_long
JWT_ACCESS_EXPIRES_IN=15m
MAX_FILE_SIZE_MB=10
