generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  PROJECT_MANAGER
  DEVELOPER
  QA_ENGINEER
  REPORTER
}

enum UserStatus {
  ACTIVE
  INVITED
  DISABLED
}

enum ProjectStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

enum IssueStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
  REOPENED
}

enum IssuePriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IssueType {
  BUG
  TASK
  IMPROVEMENT
  FEATURE
}

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String
  role         UserRole   @default(DEVELOPER)
  status       UserStatus @default(ACTIVE)
  settings     Json       @default("{}")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  ownedProjects Project[] @relation("ProjectLead")
  reportedIssues Issue[]  @relation("IssueReporter")
  assignedIssues Issue[] @relation("IssueAssignee")
  comments      Comment[]
}

model Project {
  id          String        @id @default(cuid())
  name        String
  key         String        @unique
  description String?
  status      ProjectStatus @default(ACTIVE)
  color       String        @default("#2875ed")
  dueDate     DateTime?
  leadId      String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?

  lead   User?   @relation("ProjectLead", fields: [leadId], references: [id], onDelete: SetNull)
  issues Issue[]

  @@index([status])
  @@index([deletedAt])
}

model Issue {
  id          String        @id @default(cuid())
  key         String        @unique
  title       String
  description String        @db.Text
  type        IssueType     @default(BUG)
  status      IssueStatus   @default(OPEN)
  priority    IssuePriority @default(MEDIUM)
  projectId   String
  reporterId  String
  assigneeId  String?
  dueDate     DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Restrict)
  reporter    User         @relation("IssueReporter", fields: [reporterId], references: [id], onDelete: Restrict)
  assignee    User?        @relation("IssueAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  comments    Comment[]
  attachments Attachment[]

  @@index([projectId, status])
  @@index([assigneeId, status])
  @@index([priority])
  @@index([createdAt])
  @@index([deletedAt])
}

model Comment {
  id        String   @id @default(cuid())
  body      String   @db.Text
  issueId   String
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  issue  Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  author User  @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([issueId, createdAt])
}

model Attachment {
  id           String   @id @default(cuid())
  originalName String
  storedName   String   @unique
  mimeType     String
  size         Int
  issueId      String
  uploadedById String
  createdAt    DateTime @default(now())

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@index([issueId])
}
