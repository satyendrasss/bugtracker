NODE_ENV=development
PORT=8080
CLIENT_URL=http://localhost:5173
DATABASE_URL="postgresql://postgres:password@localhost:5432/bugtracker?schema=public"
JWT_ACCESS_SECRET=replace_with_a_long_random_secret_at_least_32_chars
JWT_ACCESS_EXPIRES_IN=15m
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# Optional: set these only when running npm run seed:admin
ADMIN_NAME=BugTracker Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_12_character_or_longer_password
